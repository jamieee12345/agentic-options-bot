.env

# Python
venv/
__pycache__/
*.pyc
*.pyo

# Dashboard-generated output (rebuilt on demand, not source)
dashboard/output/

# Local backups made during earlier deploys -- not source
*.bak

# The three trade-history logs (trade_log.jsonl, activity_log.jsonl,
