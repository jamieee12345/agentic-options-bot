# Credentials -- NEVER commit this. See .env's own header comment.
.env

# Python
venv/
__pycache__/
*.pyc
*.pyo

# Dashboard-generated output (rebuilt on demand, not source)
dashboard/output/

# Local backups made during earlier deploys -- not source
*.bak

# These four files (trade_log.jsonl, activity_log.jsonl,
# equity_history.jsonl, account_snapshot.json) are DELIBERATELY NOT
# ignored -- see the MCP migration plan: a scheduled cloud routine gets a
# fresh checkout every firing, so committing these back to the repo each
# cycle is how state persists across hourly runs. account_snapshot.json is
# also what lets dashboard/live_account_dashboard.py show account state
# without ever calling robin_stocks itself -- see
# orchestration/account_snapshot.py's module docstring. Do not add any of
# these here.
